//
// Expected: c0 at one session, c1 at two. As
// search_merge_interpolated_share.vp, but wrapped_first is sealed under kb as
// well, so both points of the sharing need Bob. Carol opens neither, and one
// Bob run opens only one of them; secret alone fixes no share, and first
// alone is one point of a two-point line, so one session holds. At two
// sessions the second Bob run opens the other, and the attacker recomposes
// second from both leaks in one execution.
attacker[active]

principal Alice[
	knows private kb, kc, secret
	generates junkb, junkc
	first, second = THRESHOLD_SPLIT[2](secret)
	wrapped_secret = ENC(kb, secret)
	wrapped_first = ENC(kb, first)
	xb = ENC(kb, junkb)
	xc = ENC(kc, junkc)
	leaks wrapped_secret, wrapped_first
]
Alice -> Bob: xb
Alice -> Carol: xc

principal Bob[
	knows private kb
	yb = DEC(kb, xb)
	leaks yb
]

principal Carol[
	knows private kc
	yc = DEC(kc, xc)
	leaks yc
]

queries[
	confidentiality? second
]
