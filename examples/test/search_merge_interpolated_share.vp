//
// Expected: c1 at one session and at two (GitHub issue #51).
//
// Bob opens what arrives under kb and Carol what arrives under kc, and each
// leaks the result. In one execution the attacker hands Bob wrapped_secret
// and Carol wrapped_first, both leaked by Alice before either receive: Bob
// leaks secret, Carol leaks first, and secret with first are two points of
// the two-of-two sharing, which gives away second. Neither replacement
// depends on the other.
//
// The union derives second from the executions that make Bob and Carol
// leak, but an interpolated share recorded the secret as its only
// ingredient, so the query-source merge for second took Bob's execution
// alone and the attack was missed at every session count. The record now
// lists every point the share is recomposed from, and the merge takes both.
//
// search_merge_interpolated_share_same_oracle.vp seals both under kb.
attacker[active]

principal Alice[
	knows private kb, kc, secret
	generates junkb, junkc
	first, second = THRESHOLD_SPLIT[2](secret)
	wrapped_secret = ENC(kb, secret)
	wrapped_first = ENC(kc, first)
	xb = ENC(kb, junkb)
	xc = ENC(kc, junkc)
	leaks wrapped_secret, wrapped_first
]
Alice -> Bob: xb
Alice -> Carol: xc

principal Bob[
	knows private kb
	yb = DEC(kb, xb)
	leaks yb
]

principal Carol[
	knows private kc
	yc = DEC(kc, xc)
	leaks yc
]

queries[
	confidentiality? second
]
